# ═══════════════════════════════════════════════════════════════
#  Portale Zoffoli — configurazione
#  Copia questo file in ".env" (stessa cartella) e compila.
#  Il file .env NON va mai su GitHub (è già in .gitignore).
# ═══════════════════════════════════════════════════════════════

# Porta e indirizzo di ascolto (8080 e 8085 sono già occupate sulla VM)
PORT=3000
HOST=0.0.0.0

# Dove salvare database e PDF
DATA_DIR=/var/lib/portale-zoffoli/data

# Password aziendale: NON scriverla qui, usa `npm run password`
# che salva solo l'hash nella riga seguente.
PORTALE_PASSWORD_HASH=

# Durata del login (ore)
SESSIONE_ORE=12

# Metti 1 solo se il portale viene servito in HTTPS
COOKIE_SECURE=0

# ── Claude ──────────────────────────────────────────────────────
# FASE DI TEST: token del tuo account Claude (Pro/Max).
# Si genera sulla VM con:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# CON LICENZA: chiave API aziendale. Quando la compili, svuota la
# riga CLAUDE_CODE_OAUTH_TOKEN qui sopra e riavvia il servizio.
ANTHROPIC_API_KEY=

# Modello (alias "opus" = il modello Opus più recente)
CLAUDE_MODEL=opus

# Durata massima di un'analisi (minuti)
ANALISI_TIMEOUT_MIN=15

# Percorso del comando claude (impostato dallo script di installazione)
CLAUDE_BIN=/var/lib/portale-zoffoli/.local/bin/claude
